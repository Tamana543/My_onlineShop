<%- include('../layouts/start.ejs') %>
     <link rel="stylesheet" href="/Css/shop.css">
<link rel="stylesheet" href="/Css/responsive.css">
<script src="/js/main.js" defer></script>
     <!-- Add more meta tags Dont forget -->
      
</head>

<body>
     <div class="container">
        <%- include('../layouts/navigation.ejs') %>
     
     <main style="flex-direction: column;">
          <div class="body_head flex">
               <form method="GET" action="/products" class="sort-form">
       
         <input type="hidden" name="min" value="<%= min || '' %>">
         <input type="hidden" name="max" value="<%= max || '' %>">
         <input type="hidden" name="category" value="<%= category || '' %>">
       
         <select name="sort" onchange="this.form.submit()">
       
           <option value="">Sort By</option>
       
           <option 
             value="newest"
             <%= sort === 'newest' ? 'selected' : '' %>
           >
             Newest
           </option>
       
           <option 
             value="low-high"
             <%= sort === 'low-high' ? 'selected' : '' %>
           >
             Price: Low to High
           </option>
       
           <option 
             value="high-low"
             <%= sort === 'high-low' ? 'selected' : '' %>
           >
             Price: High to Low
           </option>
       
           <option 
             value="a-z"
             <%= sort === 'a-z' ? 'selected' : '' %>
           >
             Name: A-Z
           </option>
       
           <option 
             value="z-a"
             <%= sort === 'z-a' ? 'selected' : '' %>
           >
             Name: Z-A
           </option>
       
         </select>
       
       </form>
     <form action="/products" method="GET" class="filter-form">

          <input type="number" name="min" placeholder="Min Price">
          <input type="number" name="max" placeholder="Max Price">

          <select name="category">
               <option value="">All</option>
               <option value="sports">Sports</option>
               <option value="suv">SUV</option>
               <option value="luxury">Luxury</option>
          </select>
          <button type="submit" class="btn">Filter</button>
     </form>
               <% if (prods.length > 0) { %>
               <div class="flex_able products-fade">
                    <% for(let product of prods){%>
                    <article class="card product-item">
                         <header class="card__header">
                              <h1 class="product__title"><%=product.title%></h1>
                         </header>
                         <div class="card__image">
                              <img src="<%= product.imageUrl %>" alt="<%=product.title%>">
                         </div>
                         <div class="card__content">
                              <p class="product__description"><%=product.description%></p>
                              <h2 class="product__price">$<%=product.price%></h2>
                         </div>
                         <div class="card__actions flex">
                              <a href="/products/<%=product.id%>" class="btn"> Detail</a>
                              <form action="/add-to-cart" method="post">
                                   <input type="hidden" name="productId" value="<%= product._id%>">
                                   <input type="hidden" name="_csrf" value="<%=csrfToken%>">
                              <button class="btn " >Add to Cart</button>
                         </form>
                         <form action="/wishlist" method="POST" class="wishlist-form">
                              <input type="hidden" name="productId" value="<%= product._id %>">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                              <button type="submit" class="wishlist-btn">
                              <i class="ri-heart-line"></i>
                              </button>
                         </form>
                         </div>
                    </article>
                    <% }%>
               </div> 
               <% }else {%>
                    <h1>No Product Yet !</h1>
                     <span style="font-size:0.9rem;">Start by adding your first product</span>
               <% }%>
          </div>
          <div class="pagination">

               <% if (hasPreviousPage) { %>
                    <a href="/products?page=<%= previousPage %>&min=<%= min || '' %>&max=<%= max || '' %>&category=<%= category || '' %>" class="btn">Prev</a>
               <% } %>

               <span class="page-info">Page <%= currentPage %> of <%= lastPage %></span>

               <% if (hasNextPage) { %>
                    <a href="/products?page=<%= nextPage %>&min=<%= min || '' %>&max=<%= max || '' %>&category=<%= category || '' %>" class="btn">Next</a>
               <% } %>

          </div>
         <%- include('../layouts/end.ejs') %>