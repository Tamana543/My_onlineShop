<%- include('../layouts/start.ejs') %>

<link rel="stylesheet" href="/Css/shop.css">
<link rel="stylesheet" href="/Css/responsive.css">
<script src="/js/main.js" defer></script>
</head>

<body>
  <div class="container">
    <%- include('../layouts/navigation.ejs') %>

    <main class="flex_1  products-fade">
      <div class="body_head flex" style="flex-direction: row !important;">

        <% if (order.length > 0) { %>
          <div class="flex_able  products-fade" >

          
             <% for (let singleOrder of order) { %>
               
              <% const orderDate = singleOrder.createdAt 
                ? new Date(singleOrder.createdAt).toLocaleDateString() 
                : "N/A"; %>

  <% for (let item of singleOrder.products) { %>

    <article class="card product-item">

      <header class="card__header">
        <h1 class="product__title"><%= item.product.title %></h1>
      </header>

      <div class="card__image">
        <img src="<%= item.product.imageUrl %>">
      </div>

      <div class="card__content">

  <p class="product__description">
    <%= item.product.description %>
  </p>

  <h2 class="product__price">
    $<%= item.product.price %>
  </h2>

  <p class="order-qty">Qty: <%= item.quantity %></p>

  <div class="order-meta">
    <span class="order-date">
      <%= orderDate %>
    </span>

    <span class="order-status <%= (singleOrder.status || 'processing').toLowerCase() %>">
      <%= singleOrder.status || 'Processing' %>
    </span>
  </div>

  <div class="order-actions">
    <a href="/order/<%=singleOrder._id%>" class="btn">Invoice</a>
    <a href="/order/<%=singleOrder._id%>?download=true" class="btn">Download</a>
    <form action="/reorder" method="POST">
  <input type="hidden" name="orderId" value="<%= singleOrder._id %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <button class="btn">Reorder</button>
</form>
  </div>

  <form action="/add-review" method="POST" class="review-form">

  <input type="hidden" name="productId" value="<%= item.product._id %>">

  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <select name="rating" required>
    <option value="">Rating</option>
    <option value="5">★★★★★</option>
    <option value="4">★★★★</option>
    <option value="3">★★★</option>
    <option value="2">★★</option>
    <option value="1">★</option>
  </select>

  <textarea 
    name="reviewText"
    placeholder="Write your review..."
    required
  ></textarea>

  <button class="btn">
    Submit Review
  </button>

</form>
</div>

    </article>

  <% } %>
<% } %>
          </div>
        <% } else { %>
          <h1 style=" width: 100%;">No Product Yet!</h1>
           
        <% } %>

      </div>
    </main>

    <%- include('../layouts/end.ejs') %>
