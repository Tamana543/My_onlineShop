<%- include('../layouts/start.ejs') %>

<link rel="stylesheet" href="/Css/shop.css">
<link rel="stylesheet" href="/Css/responsive.css">
<script src="/js/main.js" defer></script>

</head>
<body>

<%- include('../layouts/navigation.ejs') %>

<div class="container product-detail-container flex">

  <div class="product-detail-card flex">

    <div class="product-detail-image">
      <img src="<%= product.imageUrl %>" alt="<%= product.title %>">
    </div>

    <div class="product-detail-content flex">

      <h1 class="product-title"><%= product.title %></h1>

      <p class="product-price">$<%= product.price %></p>

      <div class="product-rating">
        ⭐ <%= avgRating %> / 5
      </div>
      <p class="product-desc"><%= product.description %></p>
  <div class="reviews-section flex">

  <h2 class="review_head">Customer Reviews</h2>

  <% if(reviews.length > 0){ %>

    <% reviews.forEach(review => { %>

      <div class="review-box">

        <!-- <h4><%= review.username %></h4> -->

        <div class="product-rating">

       <% if(reviews.length > 0){ %>

      ⭐ <%= avgRating %> / 5

      <% } else { %>

      No ratings yet

  <% } %>

</div>

        <p><%= review.reviewText %></p>

      </div>

    <% }) %>

  <% } else { %>

     <p>No reviews yet.</p>

  <% } %>

</div>
      <div class="product-actions flex">

        <form action="/add-to-cart" method="post">
          <input type="hidden" name="productId" value="<%= product._id %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn details_btn">Add to Cart</button>
        </form>

        <form action="/wishlist" method="POST">
          <input type="hidden" name="productId" value="<%= product._id %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn wishlist-btn">
            <i class="ri-heart-line"></i>
          </button>
        </form>

      </div>

    </div>

  </div>
<% if(recentProducts && recentProducts.length > 0){ %>

<div class="recent-products">

    <h2>Recently Viewed</h2>

    <div class="recent-grid">

        <% recentProducts.forEach(prod => { %>

            <div class="recent-card">

                <img src="<%= prod.imageUrl %>" alt="">

                <h3><%= prod.title %></h3>

                <p>$<%= prod.price %></p>

                <a href="/products/<%= prod._id %>" class="btn">
                    View
                </a>

            </div>

        <% }) %>

    </div>

</div>

<% } %>
</div>

<%- include('../layouts/end.ejs') %>