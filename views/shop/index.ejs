<%- include('../layouts/start.ejs') %>
     <link rel="stylesheet" href="/Css/shop.css">
<link rel="stylesheet" href="/Css/responsive.css">
<script src="/js/main.js" defer></script>

     <!-- Add more meta tags Dont forget -->
      
</head>

<body>
     <div class="container">
        <%- include('../layouts/navigation.ejs') %>
     
     <main style="flex-direction: column;">
          <div class="body_head flex">
               <% if (prods.length > 0) { %>
               <div class="card__image flex_able products-fade">
                    <% for(let product of prods){%>
                    <article class="card product-item">
                         <header class="card__header">
                              <h1 class="product__title"><%=product.title%></h1>
                         </header>
                         <div class="card__image">
                              <img src="<%=product.imageUrl%>" alt="<%=product.title%>">
                         </div>
                         <div class="card__content">
                              <p class="product__description"><%=product.description%></p>
                              <h2 class="product__price">$<%=product.price%></h2>
                               <p class="product-stock">
                                   <% if(product.stock > 0){ %>
                                        In Stock: <%= product.stock %>
                                   <% } else { %>
                                        Out of Stock
                                   <% } %>
                              </p>
                              <% if(product.stock > 0 && product.stock <= 3){ %>
                              <p class="low-stock">
                                   Only <%= product.stock %> left!
                              </p>
                              <% } %>
                         </div>
                         <div class="card__actions">
                              <form action="/add-to-cart" method="post">
                                   <input type="hidden" name="productId" value="<%= product._id%>">
                                   <input type="hidden" name="_csrf" value="<%=csrfToken%>">
                             <% if(product.stock > 0){ %>

                                   <button class="btn">
                                   Add to Cart
                                   </button>

                                   <% } else { %>

                                   <button class="btn" disabled>
                                   Out of Stock
                                   </button>

                              <% } %>
                              
                         </form>
                         </div>
                    </article>
                    <% }%>
               </div> 
               <% }else {%>
                    <h1>No Product Yet !</h1>
                     <span style="font-size:0.9rem;">Start by adding your first product</span>
               <% }%>
          </div>
         <%- include('../layouts/end.ejs') %>