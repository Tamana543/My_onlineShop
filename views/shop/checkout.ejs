<%- include('../layouts/start.ejs') %>

<link rel="stylesheet" href="/Css/responsive.css">
<script src="/js/main.js" defer></script>
</head>

<body>

<div class="container">
<%- include('../layouts/navigation.ejs') %>

<main class="flex" style="flex-direction: column; gap: 20px; align-items: center;">
<div class="checkout-wrapper">
<h1 class="checkout-title">Checkout</h1>

<!--Product -->
<div class="checkout-card">
  <div class="checkout-summary">
    <% let total = 0; %>

    <% prods.forEach(p => { 
      total += p.productId.price * p.quantity;
    }) %>

    <p>Total Items: <%= prods.length %></p>
    <p>value: <%= prods[0].quantity %></p>
    <h2>Total Price: $<%= total.toFixed(2) %></h2>
  </div>
</div>

<div id="cardDetails" class="card-details hidden">
  <label>Card Number</label>
  <input type="text" placeholder="1234 5678 9012 3456" maxlength="19">

  <div class="card-row">
    <div>
      <label>Expiry</label>
      <input type="text" placeholder="MM/YY" maxlength="5">
    </div>

    <div>
      <label>CVV</label>
      <input type="text" placeholder="123" maxlength="3">
    </div>
  </div>
</div>

<form class="checkout-form" id="checkoutForm"> 
  <!-- <form id="checkoutForm" class="checkout-form"> -->
  


  <label>Name</label>
  <input type="text" name="name" required>

  <label>Address</label>
  <input type="text" name="address" required>

  <label>Quantity</label>
<input 
  type="number" 
  name="quantity" 
  min="1" 
  value="1" 
  required
>
  <label>Payment Method</label>
  <select name="payment" style="background: #3f3e3e85 !important;" id="paymentMethod">
    <option value="cod" >Cash on Delivery</option>
    <option value="card">Card </option>
  </select>
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<input type="hidden" name="productId" value="<%= prods[0].productId._id %>">
  <button class="btn main_btn" type="submit" id="checkout_submit">Place Order</button>
</form>
</div>
</main>

 <%- include('../layouts/end.ejs') %>