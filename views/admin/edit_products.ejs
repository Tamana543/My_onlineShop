<%- include('../layouts/start.ejs') %>
<link href="/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
<script defer src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="/Css/addProduct.css">
<link rel="stylesheet" href="/Css/responsive.css">
<script src="/js/main.js" defer></script>
</head>
<body>
<%- include('../layouts/navigation.ejs') %>
<main>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-10">
                <div class="login-box add-product-box">
                    <div class="login-title">
                        Edit Product
                    </div>
                    <form method="post" action="/admin/edit_products" class="login-form">
                        <div class="form-group mb-4">
                            <label class="form-control-label">TITLE</label>
                            <input
                                type="text"
                                name="title"
                                class="form-control"
                                value="<%= product.title %>"
                            >
                        </div>
                        <div class="form-group mb-4 image-pre-cont">
                            <label class="form-control-label">IMAGE URL</label>
                            <input
                                type="text"
                                name="imageUrl"
                                id="imageUrl"
                                class="form-control"
                                value="<%= product.imageUrl %>"
                            >
                            <div id="floatingPreview" class="floating-preview hidden">
                                <img id="previewImage" src="<%= product.imageUrl %>" alt="Preview">
                            </div>
                        </div>
                        <div class="form-group mb-4">
                            <label class="form-control-label">PRICE</label>
                            <input
                                type="number"
                                step="0.01"
                                name="price"
                                class="form-control"
                                value="<%= product.price %>"
                            >
                        </div>
                        <div class="form-group mb-4">
                            <label class="form-control-label">DESCRIPTION</label>
                            <textarea
                                name="description"
                                rows="5"
                                class="form-control"
                            ><%= product.description %></textarea>
                        </div>
                        <div class="form-group mb-4">
                            <label class="form-control-label">STOCK</label>
                            <input
                                type="number"
                                name="stock"
                                class="form-control"
                                min="0"
                                value="<%= product.stock %>"
                                required
                            >
                        </div>
                        <input type="hidden" name="prodId" value="<%= product._id %>">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="text-center mt-4">
                            <button type="submit" class="btn custom-btn px-5">
                                EDIT PRODUCT
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>
<%- include('../layouts/end.ejs') %>