<%- include('../layouts/start.ejs') %>
     <link rel="stylesheet" href="/Css/addProduct.css">
     <link rel="stylesheet" href="/Css/responsive.css">
     <script src="/js/main.js" defer></script>
</head>

<body>
     <%- include('../layouts/navigation.ejs') %>
     <div class="container">
     <main class="flex add_product-main">
          <form method="post" action="/admin/add-product" class="form flex ">
                 <% if (errorMessage) { %>
                    <div class="oaerror warning">
                         <strong>Error</strong> - <%=errorMessage %>
                    </div>
               <% } %>
               <div class="form-control flex">
                    <label for="title">Title</label>
                    <input type="text" name="title" class="add_inputs"   value="<%= oldInput ? oldInput.title : '' %>">
               </div>

               <div class="form-control flex image-pre-cont">
                    <label for="imageUrl">Image URL</label>
                    <input type="text" name="imageUrl" class="add_inputs" id="imageUrl"   value="<%= oldInput ? oldInput.imageUrl : '' %>">
                    <div id="floatingPreview" class="floating-preview hidden">
                         <img id="previewImage" src="" alt="Preview">
                    </div>
               </div>

               <div class="form-control flex">
                    <label for="price">Price</label>
                    <input type="number" name="price" step="0.01" class="add_inputs"   value="<%= oldInput ? oldInput.price : '' %>">
               </div>
                <div class="form-control category">
               <label for="category">Category</label>
                    <select name="category" id="category" required>
                         <option value="">Select Category</option>
                         <option value="supercar">Supercar</option>
                         <option value="suv">SUV</option>
                         <option value="coupe">Coupe</option>
                         <option value="limited">Limited Edition</option>
                    </select>
               </div>
               <div class="form-control flex">
                    <label for="description">Description</label>
                    <textarea name="description" id="description" rows="5" class="add_inputs"   value="<%= oldInput ? oldInput.description : '' %>"></textarea>
                   
               </div>
              
               <input type="hidden" name="_csrf" value="<%=csrfToken%>">
               <button type="submit" class="add_product-btn">Add Product</button>
          </form>
          <%- include('../layouts/end.ejs') %>